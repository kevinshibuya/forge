{
  "name": "@forge/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start:dev": "npm run build -w @forge/shared -w @forge/engine-cli --prefix .. && nest start --watch --entryFile main.dev",
    "start:api": "npm run build -w @forge/shared --prefix .. && nest start --entryFile main",
    "build": "nest build",
    "pretest": "npm run build -w @forge/shared -w @forge/engine-cli --prefix ..",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run build -w @forge/shared -w @forge/engine-cli --prefix ..",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "nest build && node dist/seed/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@forge/shared": "*",
    "@mozilla/readability": "^0.6.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.0",
    "exceljs": "^4.4.0",
    "fast-glob": "^3.3.3",
    "linkedom": "^0.18.13",
    "luxon": "^3.7.2",
    "openai": "^7.23.0",
    "playwright": "^1.61.1",
    "postgres": "^3.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "undici": "^7.29.1",
    "unpdf": "^1.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@forge/engine-cli": "*",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.7.0",
    "@types/express": "^4.17.0",
    "@types/luxon": "^3.7.2",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "@vercel/nft": "^1.11.0",
    "drizzle-kit": "^0.28.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^2.0.0"
  }
}
